#!/bin/sh
set -e

case "$1" in
  configure)
    if ! getent passwd pixelserv >/dev/null; then
      adduser --system --group --no-create-home --home /var/lib/pixelserv --shell /usr/sbin/nologin pixelserv
    fi
    mkdir -p /var/lib/pixelserv
    chown pixelserv:pixelserv /var/lib/pixelserv
    chmod 750 /var/lib/pixelserv
    if [ ! -f /var/lib/pixelserv/ca.crt ] || [ ! -f /var/lib/pixelserv/ca.key ]; then
      cat <<MSG
--------------------------------------------------------------------
pixelserv-tls needs a CA before HTTPS works. Create one with:

  sudo openssl req -x509 -newkey rsa:2048 -nodes -days 3650 \\
    -keyout /var/lib/pixelserv/ca.key -out /var/lib/pixelserv/ca.crt \\
    -subj "/CN=pixelserv-tls CA"
  sudo chown pixelserv:pixelserv /var/lib/pixelserv/ca.*
  sudo chmod 600 /var/lib/pixelserv/ca.key
  sudo systemctl restart pixelserv-tls

Then install ca.crt as a trusted root on your devices.
Ports 80 and 443 must be free. Options: /etc/default/pixelserv-tls
--------------------------------------------------------------------
MSG
    fi
    ;;
  abort-upgrade|abort-remove|abort-deconfigure)
    ;;
  *)
    echo "postinst called with unknown argument \`$1'" >&2
    exit 1
    ;;
esac

#DEBHELPER#

exit 0
